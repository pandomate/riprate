# ── Required ──────────────────────────────────────────────
# Strong random string used to sign session cookies (openssl rand -hex 32).
SECRET_KEY=

# ── Session security ──────────────────────────────────────
# Set to true when serving over HTTPS (marks cookies Secure)
SESSION_SECURE=false

# ── Storage ───────────────────────────────────────────────
# Absolute path where Movies/ and Shows/ sub-dirs will be created
MEDIA_DIR=./media
# Optional host mountpoint that must be mounted before start.sh can proceed.
MEDIA_MOUNT=
# Expected filesystem inside Docker; prevents falling back to the local disk. Blank = detected by start.sh.
MEDIA_EXPECTED_FSTYPE=

# ── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite:////app/data/riprate.db

# ── Downloader ────────────────────────────────────────────
MAX_CONCURRENT_DOWNLOADS=3
SEGMENT_CONNECTIONS=3

# Stream quality is resolution-driven: Settings → "Preferred quality"
# (default 1080p, falls back to the next lower when unavailable).
PREFERRED_QUALITY=1080

# Subtitle language searched in stream tracks and Wyzie (ISO-639-1 code).
# The Settings page defaults this to English.
SUBTITLE_LANGUAGE=en
# Align downloaded subtitles to the video's audio locally before muxing.
SUBTITLE_AUTO_SYNC=true

# If a download would still exceed this size (GB), re-encode it with
# libx264 at VIDEO_CRF to shrink it. Otherwise streams are copy-remuxed
# to MP4 with no quality loss. A 2-hour 1080p movie is often 6–8 GB, so
# keep this above that unless you want shrink re-encodes.
MAX_FILE_SIZE_GB=10.0

# CRF/preset used only when a re-encode is required
# (lower CRF = better quality / bigger file; 20/medium keeps detail)
VIDEO_CRF=20
VIDEO_PRESET=medium

# ── Download history ──────────────────────────────────────
# Auto-clean history older than N days (0 = keep forever). Also editable in
# the app's Settings page, which writes the value back here.
HISTORY_RETENTION_DAYS=30
# Failed temp files: 0 deletes immediately, positive = hours to keep until cleanup/restart
FAILED_TEMP_RETENTION_HOURS=0

# ── SEARCH SOURCE ─────────────────────────────────────────────────
# Search/seasons/episodes source: tmdb requires TMDB_API_KEY; imdb does not.
SEARCH_SOURCE=tmdb

# ── IMDB access cookie ────────────────────────────────────────────
# Optional. If IMDB blocks ordinary HTTP requests, paste a current browser
# Cookie header from imdb.com here.
# Get it: DevTools → Network → any imdb.com request → right-click → Copy → Cookie
IMDB_COOKIE=

# ── TMDB (metadata & artwork) ─────────────────────────────────────
# v4 "API Read Access Token" from themoviedb.org → Settings → API.
# Powers Watch-page posters/plots (cached locally), richer Jellyfin NFOs,
# and Nova's TMDB-based stream lookup. Also settable in the app's
# Settings page. Leave empty to disable all TMDB features.
TMDB_API_KEY=

# ── Wyzie Subs (subtitle downloads) ───────────────────────────────
# Free API key from store.wyzie.io/redeem.
# When enabled with a key, Wyzie is tried first in the selected subtitle language.
# Stream subtitles are the fallback if Wyzie is disabled or unavailable.
# Enable/disable and configure the key in Setup or Settings → Wyzie Subs.
WYZIE_API_KEY=
WYZIE_ENABLED=false

# ── OpenVPN health / rotation ─────────────────────────────
# Check direct public IPv4 egress every 30 seconds. After two consecutive
# failed checks, RipRate rotates to another enabled OpenVPN source and keeps
# downloads gated until the replacement is verified.
VPN_OPENVPN_HEALTH_INTERVAL=30
VPN_OPENVPN_HEALTH_FAILURES=2
